<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan redirect jika file atau folder asli memang ada
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ ^$1 [N]

    # Arahkan semua request ke folder public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
